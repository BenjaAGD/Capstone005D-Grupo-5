# Copia este archivo como .env y completa tus llaves. NUNCA subas el .env a GitHub.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=tu-llave-de-supabase
SUPABASE_ANON_KEY=tu-clave-publica-de-supabase
DIRECTA_ENV=production
DIRECTA_ALLOWED_ORIGINS=https://tu-aplicacion.example
# SUPABASE_KEY es la clave de servicio SOLO del servidor; no va en Flutter.
# Si Auth usa un host diferente del endpoint interno del servidor:
# SUPABASE_AUTH_ISSUER=https://tu-proyecto.supabase.co/auth/v1
NVIDIA_API_KEY=nvapi-...
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Opcionales (valores por defecto de ia_config.py / main.py)
# LLM_PRIMARY=groq
# GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Verificación de respuestas (capa 1 código + capa 2 verificador en el otro proveedor + capa 3 corrección)
# VERIFICAR_CHAT=1              # 0 = el chat no verifica (solo muestra la respuesta)
# VERIFICAR_ANALISIS=1          # 0 = no se revisan las señales altas/críticas del análisis
# VERIFICADOR_PROVEEDOR=auto    # auto = el proveedor distinto al que redactó; o groq / nvidia
# VERIFICADOR_SUBAGENTES=unificado   # unificado = 1 llamada; separado = cifras, evidencia y período por separado
