# ============================================================================
# DIRECTA — variables de entorno.
# Copia este archivo como `.env`, pega TUS valores y NO lo subas a ningún repositorio ni lo compartas.
#   cp .env.example .env
# `.env` está en .gitignore y en .dockerignore: nunca entra a la imagen de Docker; se entrega al
# contenedor en tiempo de ejecución (docker compose lo lee con `env_file`).
# ============================================================================

# --- Gemini (obligatorio) ---------------------------------------------------
# Tu llave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_aqui_tu_llave
# Opcional: más llaves para repartir la cuota (se rotan solas si una se agota). Separadas por coma.
# GEMINI_API_KEYS=llave_2,llave_3
# Modelo de chat y análisis. Si el nombre no existe para tu cuenta, ejecuta `python probar_gemini.py --modelos`.
GEMINI_MODEL=gemini-3.8-flash
# Modelos de respaldo si el principal falla o se queda sin cuota (separados por coma)
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite
# Opcional: un modelo distinto revisa las respuestas del primero (doble verificación más independiente)
# GEMINI_MODEL_VERIFICADOR=
EMBEDDING_MODEL=gemini-embedding-001

# --- Base de datos (Supabase) ----------------------------------------------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=pega_aqui_la_llave_de_supabase
# Modo demo SIN Supabase (todo en memoria, se pierde al apagar). Déjalo comentado en producción.
# DIRECTA_DB=memoria

# --- Verificación de respuestas -----------------------------------------------
# completa = código + sub-agentes LLM + contraste con memorias anuales (recomendado)
VERIFICACION_MODO=completa
# unificado = 1 llamada con 3 roles (más barato) | separado = 3 llamadas (cifras, evidencia, coherencia)
VERIFICADOR_SUBAGENTES=unificado
CORREGIR_AUTOMATICO=1

# --- Aprendizaje de los agentes ----------------------------------------------
AGENTES_APRENDEN=1
# Dónde se guardan los datos locales (en Docker es el volumen /app/datos_locales)
# DIRECTA_DATOS_DIR=/app/datos_locales
